    <add key="CuteWebUI.AjaxUploader.GlobalMaxSizeKB" value="30720" />
    <add key="CuteWebUI.AjaxUploader.TempDirectory" value="~\temp" />
    <add key="correoDe" value="auto-generado@serviarchivo.com" />
    <add key="correoPara" value="auto-generado@serviarchivo.com" />
    <add key="correoSmtpHost" value="smtp.gmail.com" />
    <add key="correoCredencial" value="auto-generado@serviarchivo.com" />
    <add key="correoCredencialClave" value="âÚÝéÔÒÜâÑÒãÓÙääÜ" />
